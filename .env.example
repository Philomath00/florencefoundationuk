# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project Settings → Environment Variables for
# Preview and Production deployments.

# --- Supabase (database, auth, storage) ---
# From Supabase dashboard → Project Settings → API.
# These are the public URL and publishable (anon) key — safe to expose to
# the browser. All server-side access goes through Row Level Security
# policies rather than a service-role key, so no secret key is needed here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (contact form email) ---
# From Resend dashboard → API Keys.
RESEND_API_KEY=
# Must be an email address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Grace Compassion Crew Foundation Website <onboarding@resend.dev>"
# Where contact form submissions are emailed. Defaults to the address in
# src/content/site.ts if unset. The submission is always saved to Supabase
# regardless of whether this email send succeeds.
CONTACT_RECIPIENT_EMAIL=info@florencefoundation.co.uk

# --- Admin auth ---
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.florencefoundation.co.uk
